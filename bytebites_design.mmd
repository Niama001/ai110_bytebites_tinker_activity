classDiagram
    class Customer {
        +name: str
        +purchaseHistory: list~Order~
    }

    class MenuItem {
        +name: str
        +price: float
        +category: str
        +popularityRating: int
    }

    class Menu {
        +items: list~MenuItem~
    }

    class Order {
        +selectedItems: list~MenuItem~
        +totalCost: float
        +calculateTotal(): float
    }

    Customer "1" --> "0..*" Order : purchase history
    Menu "1" o-- "0..*" MenuItem : contains
    Order "1" --> "0..*" MenuItem : selected items